{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": ".",
    "rootDir": ".",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "resolveJsonModule": true
  },
  "include": [
    "server.ts",
    "src/features/audio/lib/ws-engine.ts",
    "src/features/audio/types.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
