# Dockerfile.bare — "맨 우분투" 클린룸.
#
# 목적: 알고리즘팀이 새 머신에서 리포를 클론했을 때와 최대한 같은 상태를 만든다.
# 그래서 여기엔 **Node도, emcc도, Rust도 없다** — scripts/setup/setup-wsl.sh 가
# 그것들을 실제로 설치하는 경로(nvm, emsdk git clone)를 진짜로 타야 검증이 된다.
#
# 도구를 미리 구워두고 싶은 유혹을 참을 것: 그 순간 L1(세팅 스크립트 완주) 검증이
# 무의미해진다. 빠른 반복 검증은 Dockerfile.warm 쪽이 담당한다.
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# 클론 직후 사람이 손에 쥐고 있는 것만: 셸, git, curl, sudo.
# (setup-wsl.sh 가 apt/sudo 로 나머지를 직접 설치하는 것을 검증하기 위함)
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl git sudo bash xz-utils tar \
    && rm -rf /var/lib/apt/lists/*

# setup-wsl.sh 는 sudo apt-get 을 호출한다 — root 로 돌리면 sudo 경로가 검증되지
# 않으므로 일반 사용자 + NOPASSWD 로 실제 사용자 환경을 흉내 낸다.
RUN useradd -m -u 1000 -s /bin/bash dev \
    && echo 'dev ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/dev \
    && chmod 0440 /etc/sudoers.d/dev

USER dev
WORKDIR /home/dev
ENV HOME=/home/dev
SHELL ["/bin/bash", "-c"]
