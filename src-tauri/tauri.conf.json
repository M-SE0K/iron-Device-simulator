{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Iron Device Audio Simulator",
  "version": "0.1.0",
  "identifier": "com.irondevice.audiosim.desktop",
  "build": {
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "Iron Device Audio Simulator",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
