// Iron Device 고도화 — 통합 데이터 모델
// 설계 문서: docs/05-data-model.md
// 변경 시: npx prisma migrate dev --name <설명>

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── 열거형 ──────────────────────────────
enum Role {
  ADMIN
  USER
  // 확장 후보: UPLOADER (명세 §5)
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SpaceType {
  SHARE
  WORK
}

// ── 1. 사용자 / 인증 (→ docs/01, 04) ─────
model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  role         Role       @default(USER)
  status       UserStatus @default(PENDING) // admin 승인 탭이 토글 (명세 §7)
  createdAt    DateTime   @default(now())

  sessions Session[]
  folders  Folder[] // 소유한 WORK 폴더
  projects Project[] // 소유한 WORK 프로젝트
}

model Session {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique // sha256(raw refresh 토큰) — raw 값은 DB에 저장하지 않음
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  revokedAt    DateTime? // 로그아웃/rotation/재사용탐지 시 세팅
  replacedById String?   @unique // rotation 체인: 이 세션을 교체한 다음 세대 세션 id

  @@index([userId])
}

// ── 2. 공간 트리 (→ docs/02) ────────────
model Folder {
  id        String    @id @default(cuid())
  name      String
  spaceType SpaceType
  parentId  String? // self-FK (null = 루트)
  parent    Folder?   @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[]  @relation("FolderTree")
  ownerId   String? // null(SHARE) | userId(WORK)
  owner     User?     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  position  Float     @default(0) // 수동(직접) 정렬 순서 — 같은 부모 형제 간 상대 위치(midpoint 재배치)
  createdAt DateTime  @default(now())
  deletedAt DateTime? // soft delete (휴지통)

  projects Project[]

  @@index([spaceType, parentId, deletedAt])
  @@index([ownerId])
}

// ── 3. 프로젝트 (→ docs/02, 03) ─────────
model Project {
  id            String    @id @default(cuid())
  name          String
  spaceType     SpaceType
  ownerId       String? // null(SHARE) | userId(WORK)
  owner         User?     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  folderId      String
  folder        Folder    @relation(fields: [folderId], references: [id])
  baseProjectId String? // Fork 출처 (Work만; 명세 §4)
  baseProject   Project?  @relation("Fork", fields: [baseProjectId], references: [id])
  forks         Project[] @relation("Fork")
  position      Float     @default(0) // 수동(직접) 정렬 순서 — 같은 폴더 형제 간 상대 위치(midpoint 재배치)
  createdAt     DateTime  @default(now())
  deletedAt     DateTime? // soft delete (휴지통)

  measurements Measurement[]
  audio        AudioAsset? // Work 업로드 음원 (1:1, 선택)

  @@index([spaceType, folderId, deletedAt])
  @@index([ownerId])
  @@index([baseProjectId])
}

// ── 5. 업로드 음원 자산 (Work CRUD; docs/02 §7) ──
// 바이트를 DB(Bytes)에 직접 저장 — Fly 재배포에도 보존. 곡당 수 MB 수준의 짧은 클립 전제.
model AudioAsset {
  id        String   @id @default(cuid())
  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  filename  String
  mimeType  String
  sizeBytes Int
  data      Bytes
  createdAt DateTime @default(now())
}

// ── 4. 분석 결과 (현 measurements/*.json 승격) ──
model Measurement {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label       String // "baseline" / "proposed" 등
  speaker     String? // "Z3 SPK" 등
  powerW      Float?
  durationSec Float
  frameCount  Int
  recordedAt  DateTime @default(now())

  summary Json // MeasurementExport.summary 통째로
  frames  MeasurementFrames?

  @@index([projectId, label])
}

model MeasurementFrames {
  id             String      @id @default(cuid())
  measurementId  String      @unique
  measurement    Measurement @relation(fields: [measurementId], references: [id], onDelete: Cascade)
  rawFrames      Json
  renderedFrames Json
}
