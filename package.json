{
  "name": "iron-device-simulator",
  "version": "0.1.0",
  "private": true,
  "main": "electron-dist/main.js",
  "scripts": {
    "bootstrap": "bash scripts/setup/bootstrap.sh",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "wasm:build": "cd electron/native/wasm-engine && ./build-wasm.sh",
    "wasm:build:debug": "cd electron/native/wasm-engine && FF_PROT_DEBUG_VI=1 WASM_OUT_DIR=../../../public/wasm-debug ./build-wasm.sh",
    "build:desktop": "./scripts/build/build-static-local.sh && echo '✓ 데스크톱 독립 웹앱 빌드 완료: out/ (로컬 확인: npx serve out)'",
    "build:desktop:debug": "WASM_MODE=debug ./scripts/build/build-static-local.sh && echo '✓ 실험(debug) 데스크톱 웹앱 빌드 완료: out/ (V/I 값 printf 덤프 포함 WASM — 값 확인 전용, E2E 지연 측정에 쓰지 말 것)'",
    "build:electron": "./scripts/build/build-electron.sh",
    "build:electron:mac": "./scripts/build/build-electron.sh --mac-only",
    "build:electron:mac:debug": "WASM_MODE=debug ./scripts/build/build-electron.sh --mac-only",
    "build:electron:windows": "./scripts/build/build-electron.sh --windows-only",
    "build:electron:linux": "./scripts/build/build-electron.sh --linux-only",
    "build:electron:main": "webpack --config webpack.electron.config.js",
    "electron:preview": "npm run build:electron:main && electron .",
    "e2e:measure": "./scripts/실험용/measure-e2e-latency.sh",
    "e2e:summarize": "node scripts/실험용/summarize-e2e-latency.js",
    "loopback:measure": "node scripts/실험용/measure-loopback-offline.js"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "echarts": "^5.6.0",
    "echarts-for-react": "^3.0.2",
    "lucide-react": "^0.503.0",
    "next": "15.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.2.0",
    "wavesurfer.js": "^7.9.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.0.1",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8",
    "eslint-config-next": "15.2.4",
    "knip": "^6.25.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "webpack": "^5.108.4",
    "webpack-cli": "^7.2.1"
  }
}
