{
  "name": "iron-device-simulator",
  "version": "0.1.0",
  "private": true,
  "author": "Iron Device Corporation and JBNU-CILAB",
  "license": "GPL-3.0-only",
  "scripts": {
    "bootstrap": "bash scripts/setup/bootstrap.sh",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "build:wasm": "./scripts/build/build-wasm.sh",
    "build:desktop": "./scripts/build/build-desktop.sh && echo '✓ 데스크톱 독립 웹앱 빌드 완료: out/ (로컬 확인: npx serve out)'",
    "build:tauri": "./scripts/build/build-tauri.sh",
    "tauri:preview": "[ -d out ] || { echo 'out/ 이 없습니다 — 먼저 npm run build:desktop 을 실행하세요.' >&2; exit 1; } && npx tauri dev",
    "verify:docker": "bash docker/verify/run.sh",
    "verify:docker:full": "bash docker/verify/run.sh --full"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.503.0",
    "next": "15.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.2.0",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "15.2.4",
    "javascript-obfuscator": "^5.5.0",
    "knip": "^6.25.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "wasm-opt": "^1.4.0"
  },
  "allowScripts": {
    "wasm-opt@1.4.0": true
  }
}
