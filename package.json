{
  "name": "iron-device-simulator",
  "version": "0.1.0",
  "private": true,
  "author": "Iron Device Corporation and JBNU-CILAB",
  "license": "GPL-3.0-only",
  "scripts": {
    "bootstrap": "bash scripts/setup/bootstrap.sh",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "wasm:build": "cd native/wasm-engine && ./build-wasm.sh",
    "wasm:build:debug": "cd native/wasm-engine && FF_PROT_DEBUG_VI=1 WASM_OUT_DIR=../../public/wasm-debug ./build-wasm.sh",
    "wasm:build:dummy": "cd native/wasm-engine && FF_PROT_DUMMY_ATTENUATION=1 WASM_OUT_DIR=../../public/wasm-dummy ./build-wasm.sh",
    "build:desktop": "./scripts/build/build-static-local.sh && echo '✓ 데스크톱 독립 웹앱 빌드 완료: out/ (로컬 확인: npx serve out)'",
    "build:desktop:debug": "WASM_MODE=debug ./scripts/build/build-static-local.sh && echo '✓ 실험(debug) 데스크톱 웹앱 빌드 완료: out/ (V/I 값 printf 덤프 포함 WASM — 값 확인 전용, E2E 지연 측정에 쓰지 말 것)'",
    "build:desktop:dummy": "WASM_MODE=dummy ./scripts/build/build-static-local.sh && echo '✓ 실험(dummy) 데스크톱 웹앱 빌드 완료: out/ (pass B 감쇠 항상 미개입 WASM — Protected==Input 검증/무보호 temp·exc 확인용)'",
    "wasm:preview": "./scripts/build/wasm-preview.sh",
    "wasm:preview:debug": "WASM_MODE=debug ./scripts/build/wasm-preview.sh",
    "wasm:preview:dummy": "WASM_MODE=dummy ./scripts/build/wasm-preview.sh",
    "build:tauri": "./scripts/build/build-tauri.sh",
    "build:tauri:mac": "./scripts/build/build-tauri.sh --mac-only",
    "build:tauri:mac:debug": "WASM_MODE=debug ./scripts/build/build-tauri.sh --mac-only",
    "build:tauri:mac:dummy": "WASM_MODE=dummy ./scripts/build/build-tauri.sh --mac-only",
    "build:tauri:windows": "./scripts/build/build-tauri.sh --windows-only",
    "build:tauri:linux": "./scripts/build/build-tauri.sh --linux-only",
    "tauri:preview": "[ -d out ] || { echo 'out/ 이 없습니다 — 먼저 npm run build:desktop 을 실행하세요.' >&2; exit 1; } && npx tauri dev",
    "e2e:measure": "./scripts/실험용/measure-e2e-latency.sh",
    "e2e:summarize": "node scripts/실험용/summarize-e2e-latency.js",
    "loopback:measure": "node scripts/실험용/measure-loopback-offline.js"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.503.0",
    "next": "15.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.2.0",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "15.2.4",
    "javascript-obfuscator": "^5.5.0",
    "knip": "^6.25.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "wasm-opt": "^1.4.0"
  },
  "allowScripts": {
    "wasm-opt@1.4.0": true
  }
}
