# 환경변수 예시 — 실제 값은 .env 에 복사해서 채우세요 (.env 는 커밋 금지)
# cp .env.example .env

# Postgres 접속 주소 (docker-compose.yml 기준 로컬 개발값)
DATABASE_URL="postgresql://irontune:irontune_pw@localhost:5432/irontune_db?schema=public"

# JWT 서명 키 (docs/01-authentication.md) — 운영 시 강한 랜덤값으로 교체
JWT_SECRET="change-me-in-production"
